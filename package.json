{
  "name": "pastecal",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "postinstall": "npm ci --prefix functions --no-audit --no-fund",
    "test": "npm run test:unit",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run test:unit:fast && npm run test:report && npm run test:unit:emulator",
    "test:unit:fast": "node test/check-node-version.js && node --test $(node test/unit-files.js | tr '\\n' ' ')",
    "test:unit:emulator": "bash test/run-emulator-tests.sh",
    "test:report": "python3 -m unittest discover -s test/report",
    "test:e2e": "bash test/run-e2e.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:smoke": "bash test/smoke-llm.sh",
    "stats": "bash scripts/stats.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@syncfusion/ej2": "23.2.6",
    "chrono-node": "1.4.9"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
