{
  // pastecal's calendar store + live sync. One Durable Object per calendar holds its data
  // in SQLite, applies every save in order, and pushes changes to open tabs over
  // hibernating WebSockets. See docs/cloudflare-migration.md.
  "name": "pastecal-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Phase 4 cutover: pastecal.com, www.pastecal.com, and new.pastecal.com
  "routes": [
    { "pattern": "pastecal.com/*", "zone_name": "pastecal.com" },
    { "pattern": "www.pastecal.com/*", "zone_name": "pastecal.com" },
    { "pattern": "new.pastecal.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",   // same as Firebase's "**" -> /index.html
    // Only these reach the Worker; everything else is served straight from the assets.
    "run_worker_first": [
      "/",            // the homepage: the Worker clears noindex here. A "/" rule in public/_headers
                      // matched locally but not on the live site (Oct 2026), so it is not relied on.
      "/cal/*",
      "/api/*",
      "/lookupCalendar",
      "/createPublicLink",
      "/*.ics",
      "/view/*.ics",
      "/beta",
      "/beta/*",
      "/nativecal/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "CALENDARS", "class_name": "CalendarRoom" },
      { "name": "DIRECTORY", "class_name": "CalendarDirectory" },
      { "name": "WAITLIST", "class_name": "Waitlist" },
      { "name": "ACCOUNTS", "class_name": "Accounts" }   // Pro owners, sessions, subscriptions (one global instance)
    ]
  },
  // New calendars from browsers (POST /cal/<id>): 10 a minute per IP.
  "ratelimits": [{ "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CalendarRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["CalendarDirectory"] },
    { "tag": "v3", "new_sqlite_classes": ["Waitlist"] },
    { "tag": "v4", "new_sqlite_classes": ["Accounts"] }
  ],
  // Copy-back to Firebase (see CalendarRoom). Inert until the FIREBASE_SA secret exists.
  // In Phase 4, COPY_BACK="*" mirrors every save back to Firebase RTDB for zero data loss and instant rollback.
  "vars": {
    "FIREBASE_DB_URL": "https://pastecal-web-default-rtdb.firebaseio.com",
    "COPY_BACK": "*"
  },
  // First-party event collector (POST /api/collect). Query with scripts/stats.sh ux.
  // Backups: each calendar writes its own snapshot here after a change (CalendarRoom.backupToR2).
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "pastecal-backups" }],
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "pastecal_events" }],
  // Sign-in links for Pro owners (Cloudflare Email Service). pastecal.com must be onboarded for sending.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["login@pastecal.com"] }],
  "observability": { "enabled": true }
  // Secrets (wrangler secret put): IMPORT_SECRET -- lets the Firebase shadow copy write;
  // FIREBASE_SA -- a service account key (JSON) that lets the room write to Firebase.
  // Billing (Accounts.js; off with a 503 until all are set): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
  // STRIPE_PRICE_PRO_YEARLY, STRIPE_PRICE_PRO_MONTHLY. ACCOUNTS_DEV_MODE, STRIPE_API_BASE and
  // LOCK_API_BASE are for local tests only (.dev.vars / --var); never set them here.
}
