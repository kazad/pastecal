{
  "rules": {
    ".read": false,
    ".write": false,
    "calendars": {
      "$id": {
        ".read": true,
        ".write": true
      }
    },
    "calendars_readonly": {
      "$id": {
        ".read": true,
        ".write": false
      }
    },
    "history": {
      "$calendarId": {
        ".read": true,
        ".write": false
      }
    },
    "slug_mappings": {
      ".read": false,
      ".write": false
    },
    "calendar_authors": {
      "$calendarId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".read": false,
          "firstSeen": {
            ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())"
          },
          "lastSeen": {
            ".validate": "newData.isNumber()"
          },
          "editCount": {
            ".validate": "newData.isNumber()"
          },
          "createdHere": {
            ".validate": "newData.isBoolean()"
          },
          "days": {
            "$day": {
              ".validate": "newData.isBoolean()"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "history_meta": {
      "$calendarId": {
        ".read": true,
        ".write": false
      }
    },
    "pro_accounts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "pro_interest": {
      ".read": false,
      "$entry": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['email', 'at'])",
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 200 && newData.val().matches(/^[^@ ]+@[^@ ]+[.][^@ ]+$/)"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "from": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "ua": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
