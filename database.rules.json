{
  "rules": {
    ".read": false,
    ".write": false,
    "calendars": {
      "$id": {
        ".read": true,
        ".write": "data.exists() || !newData.exists() || ($id.matches(/^[a-z0-9_-]{3,50}$/) && !$id.matches(/^(view|nativecal|api|ics|feed|embed|new|create|claim|share|edit|calendars|history|poll|components|demo|directives|img|js-old-components|models|services|utils|admin|administrator|www|app|apps|calendar|cal|about|account|accounts|assets|auth|bin|billing|blog|bot|cache|careers|cgi-bin|config|contact|cpanel|css|dashboard|dev|docs|download|downloads|enterprise|faq|ftp|ghost|guide|help|home|hostmaster|images|imap|index|jobs|js|legal|login|logout|mail|manage|media|me|moderator|mx|news|ns|ns1|ns2|null|oauth|password|pop|pop3|postmaster|press|pricing|privacy|pro|profile|public|recover|register|reset|root|settings|setup|signin|signout|signup|smtp|ssl|static|status|subscriptions|superuser|support|sys|sysadmin|system|team|terms|tos|undefined|user|users|v1|v2|webhooks|webmail|wiki|wp-admin|wp-content|wp-login)$/) && newData.child('id').val() === $id && !root.child('calendars_readonly').child($id).exists() && !root.child('public_views').child($id).exists())",
        "id": {
          ".validate": true
        },
        "title": {
          ".validate": true
        },
        "events": {
          ".validate": true
        },
        "options": {
          ".validate": true
        },
        "_writer": {
          ".validate": true
        },
        "_undoOf": {
          ".validate": true
        },
        "_gesture": {
          ".validate": true
        },
        "$other": {
          ".validate": "data.exists()"
        }
      }
    },
    "calendars_readonly": {
      "$id": {
        ".read": true,
        ".write": false
      }
    },
    "history": {
      "$calendarId": {
        ".read": true,
        ".write": false
      }
    },
    "slug_mappings": {
      ".read": false,
      ".write": false
    },
    "calendar_authors": {
      "$calendarId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".read": false,
          ".validate": "newData.hasChildren(['firstSeen', 'lastSeen', 'editCount']) && newData.child('lastSeen').val() === now && ((!data.exists() && newData.child('editCount').val() === 1) || (data.exists() && newData.child('editCount').val() === data.child('editCount').val() + 1)) && newData.parent().parent().parent().child('calendars').child($calendarId).exists()",
          "firstSeen": {
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === now) || (data.exists() && newData.val() === data.val()))"
          },
          "lastSeen": {
            ".validate": "newData.val() === now"
          },
          "editCount": {
            ".validate": "newData.isNumber()"
          },
          "createdHere": {
            ".validate": "newData.val() === true && !data.parent().exists() && !root.child('calendars').child($calendarId).exists() && !root.child('history').child($calendarId).exists()"
          },
          "days": {
            "$day": {
              ".validate": "$day.matches(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) && newData.val() === now"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "history_meta": {
      "$calendarId": {
        ".read": true,
        ".write": false
      }
    }
  }
}
