{
  "rules": {
    ".read": false,
    ".write": false,
    "calendars": {
      "$id": {
        ".read": true,
        ".write": "data.exists() || !newData.exists() || ($id.matches(/^[A-Za-z0-9_-]{1,100}$/) && !root.child('calendars_readonly').child($id).exists() && !root.child('calendars_readonly').child($id.toLowerCase()).exists() && !root.child('public_views').child($id.toLowerCase()).exists())"
      }
    },
    "calendars_readonly": {
      "$id": {
        ".read": true,
        ".write": false
      }
    },
    "history": {
      "$calendarId": {
        ".read": true,
        ".write": false
      }
    },
    "slug_mappings": {
      ".read": false,
      ".write": false
    },
    "calendar_authors": {
      "$calendarId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".read": false,
          ".validate": "newData.hasChildren(['firstSeen', 'lastSeen', 'editCount']) && newData.child('lastSeen').val() === now && ((!data.exists() && newData.child('editCount').val() === 1) || (data.exists() && newData.child('editCount').val() === data.child('editCount').val() + 1)) && newData.parent().parent().parent().child('calendars').child($calendarId).exists()",
          "firstSeen": {
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === now) || (data.exists() && newData.val() === data.val()))"
          },
          "lastSeen": {
            ".validate": "newData.val() === now"
          },
          "editCount": {
            ".validate": "newData.isNumber()"
          },
          "createdHere": {
            ".validate": "newData.val() === true && !data.parent().exists() && !root.child('calendars').child($calendarId).exists() && !root.child('history').child($calendarId).exists()"
          },
          "days": {
            "$day": {
              ".validate": "$day.matches(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) && newData.val() === now"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "history_meta": {
      "$calendarId": {
        ".read": true,
        ".write": false
      }
    }
  }
}
